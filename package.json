{
  "name": "dsh-quick-panel-mac",
  "version": "1.0.4-beta.4",
  "description": "Quick panel for DSH on macOS: todos, reminders, live session view and quick input.",
  "type": "module",
  "homepage": "https://github.com/cinewave0/dsh-quick-panel-mac",
  "repository": {
    "type": "git",
    "url": "https://github.com/cinewave0/dsh-quick-panel-mac.git"
  },
  "author": "cinewave0",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node test/host.test.mjs",
    "test:client": "node test/client-bundle.test.mjs",
    "test:dsh": "node test/dsh-adapter.test.mjs",
    "test:platform": "node test/platform.test.mjs",
    "demo": "node demo/run.mjs",
    "test:panel": "node test/panel.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check panel/panel.js && node --check runtime/electron-helper/main.cjs && node --check runtime/electron-helper/platform.cjs && node --check runtime/electron-helper/preload.cjs",
    "lint": "oxlint --deny-warnings src test scripts index.js panel runtime",
    "backup": "node scripts/backup.mjs",
    "sync": "node scripts/sync-github.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "panel",
    "runtime",
    "market",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.12",
    "oxlint": "^1.92.0"
  }
}
